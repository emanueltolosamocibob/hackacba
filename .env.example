# Copiar a .env y completar. Nunca commitear .env.
# Los valores locales los imprime `supabase start`.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# ---------------------------------------------------------------------------
# Secretos del bot
#
# En produccion NO salen de aca: van con `supabase secrets set`. Este bloque es
# para `supabase functions serve`, que los lee de supabase/functions/.env.
# Las tres SUPABASE_* de arriba las inyecta la plataforma sola en las Edge
# Functions; no hay que definirlas como secretos.
# ---------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
# Inventado por vos, se le pasa a setWebhook y viaja en cada update.
TELEGRAM_SECRETO_WEBHOOK=
ANTHROPIC_API_KEY=

# Opcionales, con valor por defecto en el codigo.
# MODELO_CLAUDE=claude-sonnet-5
# DOMINIO_CUENTAS=telegram.local
# MAX_TURNOS_AGENTE=6
