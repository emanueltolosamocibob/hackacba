# Copiar a .env y completar. Nunca commitear .env.
# Los valores locales los imprime `supabase start`.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Los secretos de las Edge Functions van en supabase/functions/.env
# (ver supabase/functions/.env.example). En produccion, con `supabase secrets set`.
