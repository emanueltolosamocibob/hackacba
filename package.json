{
  "name": "gestion-flota",
  "private": true,
  "version": "0.1.0",
  "description": "Gestion de pagos y vencimientos de flotas de vehiculos",
  "workspaces": [
    "paquetes/*"
  ],
  "scripts": {
    "db:push": "supabase db push",
    "db:estado": "supabase migration list",
    "db:tipos": "supabase gen types typescript --linked > paquetes/compartido/src/tipos.ts",
    "verificar": "node --env-file=.env supabase/tests/verificar.mjs",
    "verificar:realtime": "node --env-file=.env supabase/tests/verificar-realtime.mjs",
    "verificar:migraciones": "node supabase/tests/verificar-migraciones.mjs",
    "verificar:tipos": "tsc --noEmit --project paquetes/compartido/tsconfig.json",
    "verificar:todo": "npm run verificar:migraciones && npm run verificar && npm run verificar:alta && npm run verificar:bot && npm run verificar:realtime && npm run verificar:tipos && npm run web:tipos",
    "demo": "node --env-file=.env supabase/semillas/demo.mjs",
    "verificar:alta": "node --env-file=.env supabase/tests/verificar-alta.mjs",
    "verificar:bot": "node --env-file=.env supabase/tests/verificar-bot.mjs",
    "estado": "node --env-file=.env herramientas/estado.mjs",
    "bot:desplegar": "supabase functions deploy telegram agente despachar-avisos",
    "bot:tipos": "deno check supabase/functions/telegram/index.ts supabase/functions/agente/index.ts supabase/functions/despachar-avisos/index.ts",
    "alta:desplegar": "supabase functions deploy enviar-otp-whatsapp finalizar-alta-landing",
    "alta:tipos": "deno check supabase/functions/enviar-otp-whatsapp/index.ts supabase/functions/finalizar-alta-landing/index.ts",
    "alta:pruebas": "deno test --allow-env supabase/functions/_pruebas/",
    "web:dev": "npm run dev --workspace @flota/web",
    "web:construir": "npm run construir --workspace @flota/web",
    "web:tipos": "npm run tipos --workspace @flota/web"
  },
  "devDependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20.6.0"
  }
}
