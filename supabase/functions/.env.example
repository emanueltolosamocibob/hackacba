# Copiar a supabase/functions/.env y completar para `supabase functions serve`.
# Nunca commitear ese archivo. En produccion estos valores van con
# `supabase secrets set NOMBRE=valor` (o desde el Dashboard), no desde aca.

# ---------------------------------------------------------------------------
# enviar-otp-whatsapp (Auth Send SMS Hook)
# ---------------------------------------------------------------------------

# El secreto "v1,whsec_..." que el Dashboard genera al configurar el Send SMS
# Hook (Authentication > Hooks). El hook lo manda firmado con Standard
# Webhooks; esta funcion verifica esa firma antes de leer el OTP.
SEND_SMS_HOOK_SECRET=

# WAHA: un solo numero de operador atiende OTP y bot (design-2).
WAHA_BASE_URL=http://localhost:3000
WAHA_API_KEY=
WAHA_SESION=

# ---------------------------------------------------------------------------
# finalizar-alta-landing
# ---------------------------------------------------------------------------

# Origenes exactos que puede llamar la landing, separados por coma. Nunca "*".
LANDING_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
